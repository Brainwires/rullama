# Build artifacts — re-generated inside the image
target/
dist/
# NOTE: pkg/ (the wasm bundle) is NOT ignored — the image no longer builds it
# (the engine lives in the sibling rullama-framework repo). It must be prebuilt
# on the host and shipped in the build context; the Dockerfile COPYs it.

# VCS / editor / OS
.git/
.gitignore
.claude/
.idea/
.vscode/
.DS_Store
*.swp
*~

# Docs and licenses don't need to enter the build context
*.md
LICENSE-*

# Local bench / session logs
/tmp/

# The container builds its own server.py; don't ship Docker files into themselves
Dockerfile
compose.yaml
.dockerignore
