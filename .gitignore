# Rust build artifacts — any `target/` dir at any depth. Covers the root xtask
# workspace AND the `dev-server/` crate (the devserver is excluded from the
# workspace per the top-level Cargo.toml, so it builds into its own
# `services/dev-server/target/` + `services/dev-server/Cargo.lock`).
target/
/services/dev-server/Cargo.lock
**/*.rs.bk
Cargo.lock.bak

# wasm-pack / trunk output (regenerate with `wasm-pack build --target web --release`)
/pkg
/dist

# web (Vite + React + Hono PWA) — build artifacts and deps
/apps/web/node_modules
/apps/web/dist
/apps/web/dev-dist
/apps/web/.vite
/apps/web/tsconfig.tsbuildinfo
/apps/web/server/dist

# editors / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Claude Code session-local state
/.claude/

# Local audio test fixtures dropped at repo root by manual transcribe testing.
# Scoped to the root so fixtures committed under web/ or tests/ still count.
/*.mp3
/*.wav
/*.m4a

# PM2-managed devserver log files
/ops/pm2/*.log

# Local model weight downloads (Z-Image-Turbo etc.) — never commit
weights/
