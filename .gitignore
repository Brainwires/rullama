/target
# rullama-devserver is excluded from the workspace (see top-level Cargo.toml)
# so it builds into its own target/ + Cargo.lock under its crate dir.
/crates/rullama-devserver/target
/crates/rullama-devserver/Cargo.lock
**/*.rs.bk
Cargo.lock.bak

# wasm-pack / trunk output (regenerate with `wasm-pack build --target web --release`)
/pkg
/dist
/examples/pwa/.served

# examples/web (Vite + React + Hono PWA) — build artifacts and deps
/examples/web/node_modules
/examples/web/dist
/examples/web/dev-dist
/examples/web/.vite
/examples/web/tsconfig.tsbuildinfo
/examples/web/server/dist

# editors / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Claude Code session-local state
/.claude/

# Local audio test fixtures dropped at repo root by manual transcribe testing.
# Scoped to the root so fixtures committed under examples/ or tests/ still count.
/*.mp3
/*.wav
/*.m4a

# PM2-managed devserver log files
/ops/pm2/*.log
