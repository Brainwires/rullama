<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Rullama.ViewModels"
             x:Class="Rullama.Views.VoiceView"
             x:DataType="vm:VoiceViewModel"
             Background="{StaticResource Background}">
  <Design.DataContext>
    <vm:VoiceViewModel />
  </Design.DataContext>
  <TextBlock Classes="muted" Text="Voice — built in M4." HorizontalAlignment="Center" VerticalAlignment="Center" />
</UserControl>
