<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Rullama.ViewModels"
             x:Class="Rullama.Views.ChatView"
             x:DataType="vm:ChatViewModel"
             Background="{StaticResource Background}">
  <Design.DataContext>
    <vm:ChatViewModel />
  </Design.DataContext>

  <Grid ColumnDefinitions="280,*,340">
    <!-- Left: conversation list (static for M1) -->
    <Border Grid.Column="0" Background="{StaticResource Card}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBlock Classes="label" Text="HISTORY" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="outline sm" Content="New"
                  Command="{Binding NewChatCommand}" />
        </Grid>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Conversations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ConversationViewModel">
                <Border Classes="convitem" Classes.active="{Binding IsActive}" Margin="0,1">
                  <Grid ColumnDefinitions="*,Auto">
                    <Button Grid.Column="0" Classes="ghost" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="6,4"
                            Command="{Binding $parent[ItemsControl].((vm:ChatViewModel)DataContext).SelectConversationCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource Foreground}" FontSize="12" />
                        <TextBlock Text="{Binding RelativeTime}" Classes="muted" FontSize="10" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="ghost iconsm" Content="✕"
                            Command="{Binding $parent[ItemsControl].((vm:ChatViewModel)DataContext).DeleteConversationCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Center: load panel (until a model is loaded) OR conversation -->
    <Panel Grid.Column="1">
      <!-- Load panel -->
      <Border IsVisible="{Binding !IsModelLoaded}" Padding="24"
              HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
        <StackPanel Spacing="12">
          <TextBlock Classes="h1" Text="rullama" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap"
                     Text="Gemma 4, fully on-device. Load a GGUF (or an Ollama blob) to begin." />
          <TextBox Watermark="/path/to/model.gguf or Ollama blob"
                   Text="{Binding ModelPath, Mode=TwoWay}" />
          <Button Classes="primary" Content="Load model"
                  Command="{Binding LoadModelCommand}" IsEnabled="{Binding !IsBusy}"
                  HorizontalAlignment="Center" />
          <TextBlock Classes="muted" Text="{Binding Status}" HorizontalAlignment="Center"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Conversation -->
      <DockPanel IsVisible="{Binding IsModelLoaded}">
        <!-- Composer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Background}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Margin="0,0,6,0"
                     Watermark="Say something…"
                     Text="{Binding Input, Mode=TwoWay}"
                     AcceptsReturn="False">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Classes="primary" Content="Send"
                    Command="{Binding SendCommand}" IsVisible="{Binding !IsBusy}" />
            <Button Grid.Column="1" Classes="destructive" Content="Stop"
                    Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}" />
          </Grid>
        </Border>

        <!-- Messages -->
        <ScrollViewer Padding="16,12">
          <ItemsControl ItemsSource="{Binding Messages}" HorizontalAlignment="Stretch">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" MaxWidth="760" HorizontalAlignment="Center" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ChatMessageViewModel">
                <Border Classes="bubble" Classes.user="{Binding IsUser}">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="{Binding RoleLabel}" />
                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                               Foreground="{StaticResource Foreground}" FontSize="14" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Panel>

    <!-- Right: chat settings (static for M1) -->
    <Border Grid.Column="2" Background="{StaticResource Card}"
            BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
      <StackPanel Margin="10" Spacing="8">
        <TextBlock Classes="label" Text="CHAT SETTINGS" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="{Binding Status}" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Generation · Tools · Speech controls land next." />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
