<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Rullama.ViewModels"
             x:Class="Rullama.Views.ChatView"
             x:DataType="vm:ChatViewModel"
             Background="{StaticResource Background}">
  <Design.DataContext>
    <vm:ChatViewModel />
  </Design.DataContext>

  <!-- Dual-sidebar layout: HISTORY | conversation | CHAT SETTINGS -->
  <Grid ColumnDefinitions="280,*,340">
    <!-- Left: conversation list -->
    <Border Grid.Column="0" Background="{StaticResource Card}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBlock Classes="label" Text="HISTORY" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="outline sm" Content="New" />
        </Grid>
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="No prior chats yet. Send a message to start one." />
      </DockPanel>
    </Border>

    <!-- Center: messages + composer -->
    <DockPanel Grid.Column="1">
      <!-- Composer -->
      <Border DockPanel.Dock="Bottom" Background="{StaticResource Background}"
              BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="8">
        <Grid ColumnDefinitions="Auto,*,Auto" >
          <Button Grid.Column="0" Classes="ghost icon" Content="+" />
          <TextBox Grid.Column="1" Margin="6,0" Watermark="Say something…" />
          <Button Grid.Column="2" Classes="primary" Content="Send" />
        </Grid>
      </Border>
      <!-- Empty state -->
      <TextBlock Classes="muted" Text="Say hi." HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
    </DockPanel>

    <!-- Right: chat settings -->
    <Border Grid.Column="2" Background="{StaticResource Card}"
            BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
      <StackPanel Margin="10" Spacing="8">
        <TextBlock Classes="label" Text="CHAT SETTINGS" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Model · Generation · Tools · Speech — wired up in M1." />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
